# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# docker-compose automatically reads a .env file in this directory.
# All of these have working defaults baked into docker-compose.yml, so
# creating a .env is optional -- only do it if you want to change something.

# --- Ollama models ---
# "mistral" pulls the default mistral:latest (7B) tag.
# LLM_MODEL=mistral
LLM_MODEL=phi4-mini
EMBEDDING_MODEL=nomic-embed-text

# --- Ollama parallelism ---
# How many inference slots Ollama keeps open simultaneously.
# Each slot uses ~2-4 GB VRAM depending on model size.
# Set to 1 if you see OOM errors; increase if GPU has headroom.
# OLLAMA_NUM_PARALLEL=4
# Max models loaded in memory at once (LLM + embedding).
# OLLAMA_MAX_LOADED_MODELS=2

# --- Neo4j credentials ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag_password

# --- Frontend -> Backend URL ---
# This is the URL the *browser on your host machine* uses to reach the
# backend, so it should point at the port docker-compose publishes to your
# host (localhost:8000 by default), not an internal Docker service name.
# NOTE: this is baked into the frontend at build time (docker compose build),
# so if you change it, run `docker compose build frontend` again.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Ingestion ---
# Number of chunks to process in parallel during document ingestion.
# Higher values speed up ingestion but use more GPU/CPU on the Ollama server.
# Set to 1 to disable parallelism (sequential, old behavior).
# INGESTION_CONCURRENCY=4

# --- Chunking strategy ---
# "recursive" (default) — splits on paragraph/sentence/word boundaries
# "sentence" — groups N sentences per chunk (good entity extraction)
# "semantic" — detects topic boundaries via embeddings (fewest, best chunks)
CHUNKING_STRATEGY=recursive
# CHUNK_SIZE=1000          # characters per chunk (recursive only)
# CHUNK_OVERLAP=150       # character overlap (recursive only)
# CHUNK_SENTENCES_PER_CHUNK=8  # sentences per chunk (sentence strategy)
# CHUNK_SENTENCE_OVERLAP=1     # sentence overlap (sentence strategy)
# CHUNK_SEMANTIC_MAX_SENTENCES=20   # max sentences per chunk (semantic)
# CHUNK_SEMANTIC_THRESHOLD=80       # percentile for breakpoint (semantic)

# --- CORS ---
CORS_ALLOW_ORIGINS=*
